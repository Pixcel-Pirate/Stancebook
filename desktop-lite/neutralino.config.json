{
  "applicationId": "app.stancebook.desktop",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 52719,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": false,
  "logging": { "enabled": false, "writeToLogFile": false },
  "modes": {
    "window": {
      "title": "Stancebook",
      "width": 1360,
      "height": 900,
      "minWidth": 900,
      "minHeight": 640,
      "center": true,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "Stancebook",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
